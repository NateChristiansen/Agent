#!/usr/bin/env python3
"""The forced command an enrolled peer key runs (ADR-0035).

sshd starts this as `"<real python>" -I "<repo>/bin/peer-net-receive" --from-device <alias>`.
`-I` ignores PYTHONPATH and the user site, so the harness and its venv packages are put on
`sys.path` here, ahead of the standard library entries `-I` keeps. It runs from the venv's
packages without the venv's own `python.exe`, which a Windows SSH logon cannot start through
uv's junction. Nothing here takes input but the alias, and the receiver reads only stdin.
"""

import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


def _site_packages() -> list[str]:
    venv = ROOT / ".venv"
    if os.name == "nt":
        return [str(venv / "Lib" / "site-packages")]
    lib = venv / "lib"
    return [str(p / "site-packages") for p in sorted(lib.glob("python*"))] if lib.is_dir() else []


def main() -> int:
    sys.path[0:0] = [str(ROOT / "src"), *_site_packages()]
    os.chdir(ROOT)
    os.environ["AGENT_ROOT"] = str(ROOT)
    from agent_cli.cli import main as cli_main

    return cli_main(["peer-net", "receive", *sys.argv[1:]])


if __name__ == "__main__":
    raise SystemExit(main())
